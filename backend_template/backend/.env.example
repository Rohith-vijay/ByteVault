# =========================================================================
# Platform Backend Configuration File Example
# Copy this file to '.env' or '.env.local' and set the correct values.
# =========================================================================

# Database Configuration (Required)
DB_URL=jdbc:mysql://localhost:3306/platform_db?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_database_password_here

# JWT Configuration (Required)
# Generate a secret: openssl rand -base64 64
JWT_SECRET=default_super_secure_jwt_secret_placeholder_minimum_32_chars_long
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
VERIFICATION_EXPIRATION=86400000

# Front-End URL for CORS/Redirects
FRONTEND_URL=http://localhost:5173

# Administrative Bootstrap Seeding
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Encryption Key (Required - Must be a secure 32-byte string)
APP_CRYPTO_ENCRYPTION_KEY=dummy_encryption_key_must_be_32_bytes_long!

# Optional Configurations (Placeholders)
# -------------------------------------------------------------------------
# Cloudinary URL (Optional - e.g. cloudinary://key:secret@name)
CLOUDINARY_URL=
CLOUDINARY_FOLDER_NAME=app_media

# Razorpay Key Config (Optional)
RAZORPAY_KEY_ID=dummy
RAZORPAY_KEY_SECRET=dummy

# Cloudflare Turnstile CAPTCHA (Optional)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Google OAuth2 Client Configuration (Optional)
GOOGLE_CLIENT_ID=dummy-id
GOOGLE_CLIENT_SECRET=dummy-secret

# Mail Dispatch SMTP Config (Optional)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM_NAME=App Notification
APP_MAIL_FROM_EMAIL=info@example.com
