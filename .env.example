# =============================================================================
# ByteVault Media - Environment Variables Template (.env.example)
# CO-2 Security & Configuration Best Practices
# Copy to .env and configure real credentials for staging/production deployments.
# =============================================================================

# --- Database Credentials ---
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
CART_DB_PASSWORD=your_secure_cart_db_password_here

# --- Gateway Perimeter Security ---
# Shared secret for X-Gateway-Secret header verification between API Gateway and downstream microservices
GATEWAY_SECRET=your_gateway_shared_secret_here

# --- Authentication & JWT Security ---
# Must be at least 32 characters long for HMAC-SHA256
JWT_SECRET=your_super_secure_jwt_secret_placeholder_minimum_32_chars_long

# --- Payment Gateway (Razorpay) ---
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- S3 / MinIO Object Storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bytevault-media

# --- Notification (SMTP / Brevo) ---
BREVO_API_KEY=your_brevo_api_key_here
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
